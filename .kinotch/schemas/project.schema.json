{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinotch.local/schema/project.schema.json",
  "title": "KiNoTch Project Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "profile",
    "runtime",
    "surfaces",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "cli": { "type": "boolean" },
        "gui_windows": { "type": "boolean" },
        "web": { "type": "boolean" },
        "api": { "type": "boolean" },
        "mcp": { "type": "boolean" },
        "agent": { "type": "boolean" },
        "library": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "run"
            ],
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "exec"
            ],
            "properties": {
              "exec": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "forward_args": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
