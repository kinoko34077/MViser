{
  "schema_version": 1,
  "project": {
    "name": "MViser",
    "type": "media-generator",
    "description": "Music-synchronised MV material generator: chord/lyric timeline -> SceneState -> frames -> MP4 / PNG sequence."
  },
  "profile": "cli",
  "runtime": {
    "modules": []
  },
  "surfaces": {
    "cli": true,
    "gui_windows": false,
    "web": false,
    "api": false,
    "mcp": false,
    "agent": false,
    "library": false
  },
  "commands": {
    "setup": {
      "exec": "python",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "project/requirements.txt"
      ],
      "cwd": ".",
      "forward_args": false
    },
    "dev": {
      "exec": "python",
      "args": [
        "project/tools/run_mviser.py"
      ],
      "cwd": ".",
      "forward_args": true
    },
    "test": {
      "exec": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "project/tests",
        "-t",
        "project/tests",
        "-v"
      ],
      "cwd": ".",
      "forward_args": false
    },
    "build": "",
    "verify": "",
    "smoke": "",
    "deploy": ""
  },
  "paths": {
    "docs": "docs/",
    "source": "src/",
    "tests": "tests/",
    "actions": "contracts/actions.json",
    "surfaces": "contracts/surfaces.json",
    "defaults": "defaults.json"
  },
  "notes": [
    "Only README.md and project/** are normally edited in an individual repository.",
    "Python 3.10+; dependencies in project/requirements.txt (Pillow, PyYAML, imageio-ffmpeg, mido, numpy, sounddevice, ruamel.yaml); GUI needs a Python with tkinter.",
    "KiNoTch. Runtime is not used (runtime.modules empty); see project/docs/adr/0001-mvp0-architecture.md.",
    "Real-hardware checks: project/verification/manual_checks.yaml -> MViser#14."
  ],
  "profiles": [
    "cli"
  ]
}
