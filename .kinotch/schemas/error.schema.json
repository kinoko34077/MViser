{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KiNoTch Action Error",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
