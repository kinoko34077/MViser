{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinotch.local/defaults/api-error-envelope.schema.json",
  "title": "KiNoTch API Default Error Envelope",
  "type": "object",
  "required": [
    "error",
    "message"
  ],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "details": {
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
